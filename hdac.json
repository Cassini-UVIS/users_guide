{"version":2,"kind":"Article","sha256":"0319e4531b594a6d325314eb6af2bdd9df0fcf6dbd7aa40c7743448f3c28fd2c","slug":"hdac","location":"/05_hdac.md","dependencies":[],"frontmatter":{"title":"Hydrogen-Deuterium Absorption Cell (HDAC) observations","short_title":"HDAC Observations","authors":[{"id":"Pascal Hedelt","name":"Pascal Hedelt"}],"content_includes_title":false,"github":"https://github.com/cassini-uvis/users_guide","numbering":{"figure":{"enabled":true},"table":{"enabled":true},"code":{"enabled":true},"equation":{"enabled":true},"heading_1":{"enabled":true},"heading_2":{"enabled":true},"heading_3":{"enabled":true},"heading_4":{"enabled":true},"heading_5":{"enabled":true},"heading_6":{"enabled":true}},"copyright":"Cassini UVIS team","source_url":"https://github.com/cassini-uvis/users_guide/blob/jbook2/05_hdac.md","edit_url":"https://github.com/cassini-uvis/users_guide/edit/jbook2/05_hdac.md","exports":[{"format":"md","filename":"05_hdac.md","url":"/build/05_hdac-ee6c0e0ca56a66c658163123ae1f4d1a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"Nl47PdO0kS"}],"key":"yAdYUaCsw1"},{"type":"paragraph","children":[{"type":"text","value":"Not copied over yet.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"J88OnwC4iM"}],"key":"GhH7GArylq"}],"key":"InQ2sDPYEr"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"AI intro:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"UbwLOzPRHA"}],"key":"bLA03iI7UF"}],"key":"AeYQ8Ps9Qx"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"The HDAC is a special channel of UVIS that allows the insertion of a hydrogen-deuterium absorption cell in the optical path of the FUV channel.\nThe HDAC is used to measure the interplanetary medium (IPM) Lyman-α background and to separate it from planetary emissions.\nThe HDAC was used extensively during the Jupiter flyby in 2000-2001, but only occasionally during the Saturn tour, mostly for calibration purposes.\nThe HDAC was turned off in 2015 after a failure of its power supply.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"rFvVJ6QoDL"}],"key":"usssGv72ue"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The HDAC consists of a cell filled with molecular hydrogen and deuterium gas at low pressure, contained in a glass tube with MgF2 windows.\nWhen the cell is heated to about 250 °C, the gas dissociates into atomic hydrogen and deuterium, which strongly absorb light at Lyman-α (1216 Å).","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"qhWtXJxDXS"}],"key":"gzLDM2bFK1"}],"key":"bfVWXqsPQ0"}],"key":"qdF60jXqZQ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Saturn’s Aurora","url":"/saturns-aurora","group":"Cassini UVIS User Guide"},"next":{"title":"Cassini UVIS Ring and Icy Satellite Stellar Occultation Data","short_title":"Stellar Occultations","url":"/stellar-occultations","group":"Cassini UVIS User Guide"}}},"domain":"http://localhost:3000"}