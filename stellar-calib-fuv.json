"end":{"line":141,"column":1}},"key":"YhTvdU1u8A"},{"type":"link","url":"http://cuvisfu10.cal","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"cuvisfu10.cal","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"NAiQIfD6no"}],"urlSource":"http://cuvisfu10.cal","key":"rzmQNWQvQ9"},{"type":"text","value":" and scaling the resulting curve to\nachieve a low-pass curve with a constant mean value of 1, giving ","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"RpbMlmmG02"},{"type":"link","url":"http://cuvisfu11.cal","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"cuvisfu11.cal","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"Mnf5hCO4Tw"}],"urlSource":"http://cuvisfu11.cal","key":"uIbhGDZR8h"},{"type":"text","value":" as the best\ncurrent estimate of UVIS sensitivity.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"MOmtWJ6zAv"}],"key":"A8k4GSMXY8"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"text","value":"Figure 9.3: The ratio of the UVIS fuv 2001 093 αVir exposure at row 32 to the nLTE model simulation using the\noriginal lab calibration sensitivity curve ","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"aSUMc0tgxi"},{"type":"link","url":"http://cuvisfu10.cal","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"cuvisfu10.cal","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"FIItychvqe"}],"urlSource":"http://cuvisfu10.cal","key":"CdtbbI2FC2"},{"type":"text","value":", compared to the ratio obtained using the simulation with\nsensitiviy curve ","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"aFv